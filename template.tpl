___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// HubSpot Consent Banner Integrator
const isConsentGranted = require('isConsentGranted');
const createQueue = require('createQueue');
const getCookieValues = require('getCookieValues');
const logToConsole = require('logToConsole');

// Access template fields
const hsAction = data.hsCookieBannerAction;
const hsIntegration = data.hsCookieBannerIntegration;
const loggingEnabled = !data.disableConsoleLogging;

// Create or connect to HubSpot queues safely
const hubspotQueuePush = createQueue('_hsp');
const hubspotDoNotTrackQueuePush = createQueue('_hsq');

// Helper function to normalize consent values
function normalizeConsent(value) {
  if (value === 'hsConsentGranted' || value === 'granted' || value === true || value === 'hsConsentTrue') {
    return true;
  }
  if (value === 'hsConsentDenied' || value === 'denied' || value === false || value === 'hsConsentFalse') {
    return false;
  }
  return false;
}

// Execute based on selected action
if (hsAction === 'hsRevokeCookieConsent') {
  // Revoke HubSpot Cookie Consent
  hubspotQueuePush(['revokeCookieConsent']);
  if (loggingEnabled) logToConsole('HubSpot cookie consent revoked.');

} else if (hsAction === 'hsShowBanner') {
  // Show HubSpot Consent Banner
  hubspotQueuePush(['showBanner']);
  if (loggingEnabled) logToConsole('HubSpot cookie consent banner shown.');

} else if (hsAction === 'hsIntegrateThirdPartyConsentBanner') {
  // Integrate custom/third-party consent banner with HubSpot
  let analyticsConsent;
  let advertisementConsent;
  let functionalityConsent;

  if (hsIntegration === 'hsIntegrateConsentMode') {
    // Use Google Consent Mode signals
    analyticsConsent = isConsentGranted('analytics_storage');
    advertisementConsent = isConsentGranted('ad_storage');
    functionalityConsent = isConsentGranted('functionality_storage');
    if (loggingEnabled) logToConsole('Using Google Consent Mode signals for HubSpot integration.');

  } else if (hsIntegration === 'hsIntegrateManualMethod') {
    // Use manual configuration
    analyticsConsent = normalizeConsent(data.hsConsentSettingsAnalytics);
    advertisementConsent = normalizeConsent(data.hsConsentSettingsAds);
    functionalityConsent = normalizeConsent(data.hsConsentSettingsFunctional);
    if (loggingEnabled) logToConsole('Using manual consent settings for HubSpot integration.');
  }

  // Push consent settings to HubSpot
  hubspotQueuePush([
    'setHubSpotConsent',
    {
      analytics: analyticsConsent,
      advertisement: advertisementConsent,
      functionality: functionalityConsent,
    },
  ]);

  if (loggingEnabled) {
    logToConsole('HubSpot consent state updated:', {
      analytics: analyticsConsent,
      advertisement: advertisementConsent,
      functionality: functionalityConsent,
    });
  }

} else if (hsAction === 'hsDonotTrack') {
  // Trigger HubSpot Do Not Track signal
  hubspotDoNotTrackQueuePush(['doNotTrack']);
  if (loggingEnabled) logToConsole('HubSpot Do Not Track signal executed.');

} else if (hsAction === 'hsDisableDonotTrack') {
  // Disable the Do Not Track cookie if it exists
  const doNotTrackCookie = getCookieValues('__hs_do_not_track');
  if (doNotTrackCookie && doNotTrackCookie.length > 0) {
    hubspotDoNotTrackQueuePush(['doNotTrack', { track: true }]);
    if (loggingEnabled) logToConsole('HubSpot Do Not Track cookie disabled.');
  } else if (loggingEnabled) {
    logToConsole('No __hs_do_not_track cookie found — skipping disable action.');
  }
}

// Signal successful completion
data.gtmOnSuccess();


